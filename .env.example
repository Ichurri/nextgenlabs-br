# Copiá este archivo como .env.local y completá los valores.
# Guía paso a paso: docs/supabase-setup.md
#
# NINGUNA de estas variables lleva el prefijo NEXT_PUBLIC_. Ese prefijo las
# publicaría en el bundle del navegador: la service key salta todo RLS, y el
# session secret expuesto permite forjar una sesión de administrador.

# Supabase (Fase 5). Se leen solo desde el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Panel del dueño (Fase 5.6). Hasta esa fase pueden quedar vacías.
#
# Hash scrypt de la contraseña, formato "salt:hash". Nunca la contraseña en
# texto plano. Generalo con:
#   node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=
#
# 32 bytes aleatorios que firman la cookie de sesión. Usá uno distinto en dev
# y en prod. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
