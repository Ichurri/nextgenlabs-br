# Copie para .env.local. Este arquivo configura a aplicação; não cria banco local.
# A aplicação local e a publicada usam o mesmo Supabase brasileiro de produção.
# Nunca publique as chaves privadas.
# Guia: docs/brasil-setup.md
SUPABASE_URL=https://nztritrqjzhlngnokhdj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# A senha do painel é armazenada apenas como hash scrypt.
# Gere com: node scripts/hash-password.mjs
ADMIN_PASSWORD_HASH=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Domínio público do site brasileiro; em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
